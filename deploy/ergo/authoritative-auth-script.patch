+// credentialsManagedExternally says whether client may not change its own
+// credentials or unregister: an authoritative auth-script manages them, and
+// only operators with accreg may.
+func credentialsManagedExternally(server *Server, client *Client) bool {
+	return server.Config().Accounts.AuthScript.Authoritative && !client.HasRoleCapabs("accreg")
+}
